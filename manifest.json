{
  "manifest_version": 3,
  "name": "图片溯源与辟谣助手",
  "version": "1.0.0",
  "description": "聚合多引擎反向搜图、EXIF/PNG生成参数、C2PA凭证WASM验签与Wayback时间线，辅助事实核查并生成受控辟谣图文。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "contextMenus",
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开图片溯源与辟谣工作台",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "options/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/page-probe.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/text-probe.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  },
  "commands": {
    "investigate-primary-image": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "核查当前页面主图"
    },
    "investigate-page-text": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "核查当前页面的文本内容"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
